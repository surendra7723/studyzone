# ============================================
# Docker Environment Configuration
# ============================================
# Copy this file to .env.docker and modify values as needed
# ============================================

# ============================================
# Core Application Settings
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production-use-python-manage.py-generate_secret_key
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-domain.com

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
POSTGRES_DB=studyzone
POSTGRES_USER=studyzone
POSTGRES_PASSWORD=change-this-password-in-production
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgres://studyzone:change-this-password-in-production@db:5432/studyzone

# External database port (for local access)
DB_EXTERNAL_PORT=5433

# ============================================
# Redis Configuration
# ============================================
REDIS_PASSWORD=change-this-redis-password-in-production
REDIS_EXTERNAL_PORT=6380

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=redis://:change-this-redis-password-in-production@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-this-redis-password-in-production@redis:6379/1

# ============================================
# Django Channels (WebSocket) Configuration
# ============================================
CHANNEL_REDIS_URL=redis://:change-this-redis-password-in-production@redis:6379/2

# ============================================
# Social Presence Redis Configuration
# ============================================
SOCIAL_PRESENCE_REDIS_URL=redis://:change-this-redis-password-in-production@redis:6379/3
SOCIAL_PRESENCE_TTL_SECONDS=90

# ============================================
# Email Configuration (Mailpit for development)
# ============================================
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=Studyzone <no-reply@studyzone.local>

# Production email settings (example for SendGrid)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your-sendgrid-api-key
# EMAIL_USE_TLS=true

# ============================================
# Social Authentication
# ============================================
SOCIAL_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=your-google-client-id
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ============================================
# Email Verification URLs
# ============================================
EMAIL_VERIFICATION_URL_BASE=http://localhost:8000
SOCIAL_LINK_CONFIRM_URL_BASE=http://localhost:8000

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Web Push Notifications (VAPID)
# ============================================
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
VAPID_AUDIENCE=

# ============================================
# Twilio Configuration (SMS)
# ============================================
MOCK_TWILIO=true
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number

# ============================================
# Superuser Creation (optional, for initial setup)
# ============================================
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-admin-password

# ============================================
# Security Settings (Production only)
# ============================================
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ============================================
# Resource Limits (adjust based on your server)
# ============================================
# WEB_MEMORY_LIMIT=1G
# WORKER_MEMORY_LIMIT=1G
# REDIS_MEMORY_LIMIT=512M
